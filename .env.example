# Telegram BotFather token. The bot can run without this, but cannot send alerts.
TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram numeric IDs. These users become initial admins.
TELEGRAM_ADMIN_IDS=

# SQLite is persisted in ./data. PostgreSQL is not required for one instance.
DATABASE_URL=sqlite:///./data/housing.db

# Polling (seconds). Pararius requests are limited to its public Amsterdam search routes.
PARARIUS_POLL_SECONDS=120
PUBLIC_SOURCE_POLL_SECONDS=300
HTTP_TIMEOUT_SECONDS=15
MAX_CONCURRENT_REQUESTS=2
USER_AGENT=AmsterdamHousingHunter/0.1 (personal housing search; contact: set-your-email@example.com)

# OpenRouteService is optional; without a key, cycling time remains UNVERIFIED.
# Create a free key and set it here to enable OSM cycling directions and geocoding.
ORS_API_KEY=

# Optional read-only IMAP intake for official property alert emails (Kamernet/Funda/etc).
# Create platform email alerts yourself, then configure a dedicated mailbox/app password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=20
# Comma-separated sender domains accepted by the email alert adapter.
IMAP_ALLOWED_DOMAINS=pararius.com,pararius.nl,kamernet.nl,funda.nl,huurexpert.nl,iamexpat.nl,renthunter.nl,rentwebs.nl,verhuurtbeter.nl,vanderlinden.nl,huure.nl,facebook.com,facebookmail.com

# Local runtime data and optional backup destination
DATA_DIR=./data
BACKUP_DIR=./backups
